<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Reframe.UI.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Reframe.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PageContentPadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Uid="/ProfilesPage/Title" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock x:Uid="/ProfilesPage/Subtitle" Style="{StaticResource PageSubtitleTextStyle}"/>
        </StackPanel>

        <!-- Two cards side by side. The profile list (what the user manages) sits on the left and is wider;
             running windows (the source to create profiles from) sit on the right as a picker. -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Right card: running windows ===== -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,14,8,8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Spacing="2" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Uid="/ProfilesPage/RunningWindowsHeader"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock x:Uid="/ProfilesPage/RunningWindowsHint"
                               Style="{StaticResource SecondaryCaptionTextStyle}"/>
                </StackPanel>

                <!-- Search + show-filtered + refresh -->
                <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" x:Uid="/ProfilesPage/SearchBox" Grid.Column="0"
                             TextChanged="SearchBox_TextChanged"/>
                    <!-- Show filtered: when on, windows that were filtered out are also listed (greyed + reason), a fallback for recovering games that were filtered by mistake. -->
                    <!-- Tooltip is set from code-behind (Loc.T) because attached-property x:Uid is brittle in MRT Core. -->
                    <ToggleButton x:Name="ShowFilteredToggle" Grid.Column="1"
                                  VerticalAlignment="Stretch"
                                  Checked="ShowFilteredToggle_Toggled"
                                  Unchecked="ShowFilteredToggle_Toggled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7B3;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14"/>
                            <TextBlock x:Uid="/ProfilesPage/ShowFilteredLabel"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="RefreshButton" Grid.Column="2"
                            Click="RefreshButton_Click">
                        <FontIcon Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                    </Button>
                </Grid>

                <ListView x:Name="WindowList" Grid.Row="2"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          HorizontalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="0,0,8,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:WindowRow">
                            <!-- A filtered row is greyed out as a whole (RowOpacity); the "+ create profile" button stays usable regardless of IsFiltered (fallback). -->
                            <Grid ColumnSpacing="12" Background="Transparent"
                                  Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="/ProfilesPage/MenuCreateProfile" Click="CreateProfile_Click">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Add"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="/ProfilesPage/MenuQuickBorderless" Click="QuickBorderless_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE740;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <!-- Ignore this process (adds it to the user ignore list; disappears in normal mode); system-shell windows can't be ignored, so this item auto-hides. -->
                                        <MenuFlyoutItem x:Uid="/ProfilesPage/MenuIgnoreProcess" Click="IgnoreProcess_Click"
                                                        Visibility="{x:Bind IgnoreItemVisibility, Mode=OneWay}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED1A;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <!-- Stop ignoring (removes it from the list); shown only for rows the user has ignored. -->
                                        <MenuFlyoutItem x:Uid="/ProfilesPage/MenuUnignoreProcess" Click="UnignoreProcess_Click"
                                                        Visibility="{x:Bind UnignoreItemVisibility, Mode=OneWay}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7B3;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource IconTileStyle}">
                                    <Grid Width="28" Height="28">
                                        <FontIcon Glyph="&#xECAA;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="20" Opacity="0.6"
                                                  Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"/>
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28"
                                               Visibility="{x:Bind RealIconVisibility, Mode=OneWay}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind PathLabel, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Style="{StaticResource SecondaryCaptionTextStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind SizeLabel, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"/>
                                        <!-- "Already has a profile" chip: accent-tinted so it's clear at a glance which windows are already covered. -->
                                        <Border CornerRadius="4" Padding="6,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind HasProfileVisibility, Mode=OneWay}">
                                            <TextBlock x:Uid="/ProfilesPage/HasProfileTag"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                                        </Border>
                                        <!-- Filter-reason caption: System window / Ignored / Hidden / Too small. -->
                                        <Border Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                                CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind ReasonVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ReasonLabel, Mode=OneWay}" Opacity="0.85"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tooltip set from code-behind (Loc.T via Loaded) — attached-property x:Uid is brittle in MRT Core, and named elements aren't reachable inside a DataTemplate. -->
                                <Button Grid.Column="3" VerticalAlignment="Center" Padding="9,7"
                                        Click="CreateProfile_Click"
                                        Loaded="CreateFromWindowButton_Loaded">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="WindowEmptyHint" x:Uid="/ProfilesPage/WindowEmptyHint" Grid.Row="2"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
            </Border>

            <!-- ===== Left card: profile list ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,8,8,8">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row: section title at left, actions at right (same line, so the list starts higher) -->
                <Grid ColumnSpacing="8" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7FC;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Uid="/ProfilesPage/ProfileListHeader"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>

                <CommandBar Grid.Column="1" DefaultLabelPosition="Right"
                            Background="Transparent" HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOpen="False">
                    <AppBarButton x:Name="NewButton" x:Uid="/ProfilesPage/NewButton" Icon="Add" Click="NewButton_Click"/>
                    <AppBarButton x:Name="EditButton" x:Uid="/ProfilesPage/EditButton" Icon="Edit"
                                  Click="EditButton_Click" IsEnabled="False"/>
                    <AppBarButton x:Name="DeleteButton" x:Uid="/ProfilesPage/DeleteButton" Icon="Delete"
                                  Click="DeleteButton_Click" IsEnabled="False"/>
                </CommandBar>
                </Grid>

                <ListView x:Name="ProfileList" Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          DoubleTapped="ProfileList_DoubleTapped"
                          SelectionChanged="ProfileList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,8"/>
                            <Setter Property="Margin" Value="0,0,8,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProfileRow">
                            <Grid ColumnSpacing="8" Background="Transparent"
                                  ContextRequested="ProfileRow_ContextRequested">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="/ProfilesPage/MenuEdit" Click="EditButton_Click">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Edit"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Uid="/ProfilesPage/MenuDelete" Click="DeleteButton_Click">
                                            <MenuFlyoutItem.Icon>
                                                <SymbolIcon Symbol="Delete"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ToggleSwitch Grid.Column="0"
                                              VerticalAlignment="Center"
                                              MinWidth="0"
                                              OnContent="" OffContent=""
                                              IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                              Toggled="EnabledToggle_Toggled"
                                              Tag="{x:Bind ProfileId}"/>

                                <!-- Leading icon: a process match shows its icon; missing icon / non-process match falls back to the default glyph (visibility is mutually exclusive). -->
                                <Border Grid.Column="1" Style="{StaticResource IconTileStyle}">
                                    <Grid Width="28" Height="28">
                                        <FontIcon Glyph="&#xE7FC;"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="20" Opacity="0.6"
                                                  Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}"/>
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28"
                                               Visibility="{x:Bind RealIconVisibility, Mode=OneWay}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{x:Bind MatchSummary}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Style="{StaticResource SecondaryCaptionTextStyle}"/>
                                    <TextBlock Text="{x:Bind RulesSummary}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="NoWrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"/>
                                </StackPanel>

                                <!-- Tooltip set from code-behind (Loc.T via Loaded) — see note on the left-column "+" button. -->
                                <Button Grid.Column="3" VerticalAlignment="Center"
                                        Padding="10,6"
                                        IsEnabled="{x:Bind CanLaunch}"
                                        Tag="{x:Bind ProfileId}"
                                        Click="LaunchButton_Click"
                                        Loaded="LaunchButton_Loaded">
                                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyHint" x:Uid="/ProfilesPage/EmptyHint" Grid.Row="1"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           Visibility="Collapsed"/>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
